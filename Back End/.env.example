# ============================================================
# .env.example — copy to .env and fill in your real values
# NEVER commit .env to git
# ============================================================

# Server
PORT=3001

# ── SMTP Configuration (Nodemailer) ──────────────────────────
# Option A: Gmail (recommended for quick setup)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=vincelawrencequijano@gmail.com
SMTP_PASS=your-app-password          # Use Gmail App Password, not your main password

# Option B: Custom SMTP (e.g. SendGrid, Mailgun, Resend)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key

# ── Email Recipients ──────────────────────────────────────────
MAIL_FROM="Vince Quijano Portfolio <vincelawrencequijano@gmail.com>"
MAIL_TO=vincelawrencequijano@gmail.com              # Where contact form emails are delivered

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins (your frontend URL)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://yoursite.com
